/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_WINMOUSESENSCONVERTER ICON                    "WinMouseSensConverter.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 360, 154
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "About WinMouseSensConverter"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    ICON            IDI_WINMOUSESENSCONVERTER,IDC_STATIC,18,18,32,32
    LTEXT           "WinMouseSensConverter",IDC_STATIC,62,17,278,13,SS_NOPREFIX
    LTEXT           "Version 1.0.0.2",IDC_STATIC,62,34,278,10,SS_NOPREFIX
    LTEXT           "Measures horizontal raw mouse movement and converts it using a reference DPI.",IDC_STATIC,18,61,322,20,SS_NOPREFIX
    LTEXT           "wozuobuchu  |  Copyright (C) 2026",IDC_STATIC,18,88,322,10,SS_NOPREFIX
    LTEXT           "https://github.com/wozuobuchu/WinMouseSensConverter",IDC_STATIC,18,106,322,10,SS_NOPREFIX
    DEFPUSHBUTTON   "Close",IDOK,290,130,50,14,WS_GROUP
END

IDD_INSTRUCTION DIALOGEX 0, 0, 420, 274
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "WinMouseSensConverter Instructions"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "How to use",IDC_STATIC,18,16,384,13,SS_NOPREFIX
    LTEXT           "1. Accept the administrator permission prompt when the application starts.",IDC_STATIC,18,39,384,11,SS_NOPREFIX
    LTEXT           "2. In Options, choose your mouse's actual ReferenceDPI and the desired output Unit.",IDC_STATIC,18,57,384,11,SS_NOPREFIX
    LTEXT           "3. Press F1 to start recording. A new recording clears the previous measurement.",IDC_STATIC,18,75,384,11,SS_NOPREFIX
    LTEXT           "4. Move the mouse horizontally. Movement to the right is positive; movement to the left is negative.",IDC_STATIC,18,93,384,20,SS_NOPREFIX
    LTEXT           "5. Press F1 again to stop. The final measurement remains visible.",IDC_STATIC,18,120,384,11,SS_NOPREFIX
    LTEXT           "Measurement details",IDC_STATIC,18,149,384,11,SS_NOPREFIX
    LTEXT           "Only horizontal movement is displayed. Vertical movement does not affect the shown value.",IDC_STATIC,18,167,384,11,SS_NOPREFIX
    LTEXT           "Distance in inches = horizontal raw counts / ReferenceDPI. Metric units are converted from inches.",IDC_STATIC,18,185,384,20,SS_NOPREFIX
    LTEXT           "You can change DPI or unit at any time. Starting and stopping use different notification sounds.",IDC_STATIC,18,212,384,20,SS_NOPREFIX
    DEFPUSHBUTTON   "Close",IDOK,352,250,50,14,WS_GROUP
END

IDD_CUSTOM_DPI DIALOGEX 0, 0, 250, 94
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Custom Reference DPI"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Enter a Reference DPI from 1 to 999999:",IDC_STATIC,18,16,214,11,SS_NOPREFIX
    EDITTEXT        IDC_CUSTOM_DPI_VALUE,18,36,214,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,126,66,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,182,66,50,14
END


