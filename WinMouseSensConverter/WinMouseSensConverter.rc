//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_WINMOUSESENSCONVERTER ICON                    "WinMouseSensConverter.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 360, 164
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "About WinMouseSensConverter"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    ICON            IDI_WINMOUSESENSCONVERTER,IDC_STATIC,18,18,32,32
    LTEXT           "WinMouseSensConverter",IDC_STATIC,62,17,278,13,SS_NOPREFIX
    LTEXT           "Version 1.0.2.1",IDC_STATIC,62,34,278,10,SS_NOPREFIX
    LTEXT           "Measures raw mouse movement and calibrates effective mouse DPI.",IDC_STATIC,18,61,322,20,SS_NOPREFIX
    LTEXT           "wozuobuchu  |  Copyright (C) 2026",IDC_STATIC,18,88,322,10,SS_NOPREFIX
    LTEXT           "https://github.com/wozuobuchu/WinMouseSensConverter",IDC_STATIC,18,106,322,10,SS_NOPREFIX
    DEFPUSHBUTTON   "Close",IDOK,278,136,64,18,WS_GROUP
END

IDD_INSTRUCTION DIALOGEX 0, 0, 420, 328
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "WinMouseSensConverter Instructions"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Measurement mode",IDC_STATIC,18,16,384,13,SS_NOPREFIX
    LTEXT           "1. Accept the administrator permission prompt when the application starts.",IDC_STATIC,18,39,384,11,SS_NOPREFIX
    LTEXT           "2. In Options, choose the Reference DPI and output Unit.",IDC_STATIC,18,57,384,11,SS_NOPREFIX
    LTEXT           "3. Press the configured key to start. A new recording clears the previous measurement.",IDC_STATIC,18,75,384,11,SS_NOPREFIX
    LTEXT           "4. Move the mouse. Measurement mode shows signed horizontal and vertical movement.",IDC_STATIC,18,93,384,20,SS_NOPREFIX
    LTEXT           "5. Press the configured key again to stop. The final measurement remains visible.",IDC_STATIC,18,120,384,11,SS_NOPREFIX
    LTEXT           "Calibration mode",IDC_STATIC,18,149,384,11,SS_NOPREFIX
    LTEXT           "1. Choose Mode > Calibration and set the known ruler distance in Options.",IDC_STATIC,18,167,384,11,SS_NOPREFIX
    LTEXT           "2. Start recording, move the mouse once in a straight line by that distance, then stop.",IDC_STATIC,18,185,384,20,SS_NOPREFIX
    LTEXT           "3. Calibrated DPI uses sqrt(dx² + dy²) and does not change Reference DPI automatically.",IDC_STATIC,18,212,384,20,SS_NOPREFIX
    LTEXT           "Keep the mouse still while pressing the recording key. Starting and stopping use different sounds.",IDC_STATIC,18,244,384,20,SS_NOPREFIX
    DEFPUSHBUTTON   "Close",IDOK,338,300,64,18,WS_GROUP
END

IDD_CUSTOM_DPI DIALOGEX 0, 0, 270, 112
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Custom Reference DPI"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Enter a Reference DPI from 1 to 999999:",IDC_STATIC,18,16,234,12,SS_NOPREFIX
    EDITTEXT        IDC_CUSTOM_DPI_VALUE,18,38,234,18,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,118,78,64,18,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,188,78,64,18
END

IDD_CUSTOM_CALIBRATION_DISTANCE DIALOGEX 0, 0, 290, 112
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Custom Calibration Distance"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Enter a calibration distance from 10 to 1000 cm:",IDC_STATIC,18,16,254,12,SS_NOPREFIX
    EDITTEXT        IDC_CUSTOM_CALIBRATION_DISTANCE_VALUE,18,38,254,18,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,138,78,64,18,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,208,78,64,18
END

IDD_CUSTOM_RECORDING_KEY DIALOGEX 0, 0, 290, 112
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Custom Recording Key"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Enter a decimal value (1-254) or hexadecimal value (0xNN):",IDC_STATIC,18,16,254,20,SS_NOPREFIX
    EDITTEXT        IDC_CUSTOM_RECORDING_KEY_VALUE,18,42,254,18,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,138,78,64,18,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,208,78,64,18
END


